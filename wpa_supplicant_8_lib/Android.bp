cc_library_static {
    name: "lib_driver_cmd_mt66xx",
    vendor: true,
    owner: "mtk",
    // Build with the same CONFIG_* flags as wpa_supplicant itself. Without
    // them struct wpa_driver_nl80211_data has a different layout here than
    // in the supplicant (e.g. CONFIG_NAN changes struct wpa_driver_capa), and
    // fields like drv->first_bss are read from the wrong offset.
    defaults: [
        "wpa_supplicant_cflags_default",
        "wpa_supplicant_usd_defaults",
    ],
    sanitize: {
        cfi: true,
    },
    cflags: [
        "-DCONFIG_ANDROID_LOG",
    ],
    arch: {
        arm: {
            cflags: ["-mabi=aapcs-linux"],
        },
    },
    srcs: ["mediatek_driver_cmd_nl80211.c"],
    shared_libs: [
        "libc",
        "libcutils",
    ],
    include_dirs: [
        "external/wpa_supplicant_8/src",
        "external/wpa_supplicant_8/src/common",
        "external/wpa_supplicant_8/src/drivers",
        "external/wpa_supplicant_8/src/l2_packet",
        "external/wpa_supplicant_8/src/utils",
        "external/wpa_supplicant_8/src/wps",
        "external/wpa_supplicant_8/wpa_supplicant",
        "external/libnl/include",
    ],
}
